  "description": "Mutant generation (Stryker) and defect runs of the E2E suite against the Demo Shop SUT",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "stryker": "tsx scripts/stryker.ts",
    "sample": "tsx scripts/sample.ts",
    "pilot": "tsx pilot-run.ts",
