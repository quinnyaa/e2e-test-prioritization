<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title + ' · ' : '' %>Demo Shop</title>
  <link rel="icon" href="data:,">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<header class="site-header">
  <a href="/" class="logo" data-testid="nav-home">Demo Shop</a>
  <form method="get" action="/search" role="search" data-testid="search-form">
    <input type="search" name="q" placeholder="Search products" value="<%= locals.searchQuery || '' %>" data-testid="search-input" aria-label="Search products">
    <button type="submit" data-testid="search-submit">Search</button>
  </form>
  <nav class="nav">
    <a href="/catalog" data-testid="nav-catalog">Catalog</a>
    <a href="/cart" data-testid="nav-cart">Cart (<span data-testid="cart-count"><%= locals.cartCount || 0 %></span>)</a>
    <% if (locals.currentUser) { %>
      <a href="/orders" data-testid="nav-orders">My orders</a>
      <% if (currentUser.role === 'admin') { %><a href="/admin" data-testid="nav-admin">Admin</a><% } %>
      <span data-testid="user-name"><%= currentUser.name %></span>
      <form method="post" action="/logout"><button type="submit" class="secondary" data-testid="nav-logout">Sign out</button></form>
    <% } else { %>
      <a href="/login" data-testid="nav-login">Sign in</a>
      <a href="/register" data-testid="nav-register">Register</a>
    <% } %>
  </nav>
</header>
<main class="container">
<% if (locals.flash) { %>
  <div class="flash flash-<%= flash.type %>" data-testid="flash-message" role="status"><%= flash.message %></div>
<% } %>
